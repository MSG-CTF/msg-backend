Project msg_ctf_vnext {
  database_type: 'PostgreSQL'
  Note: 'Logical ERD for the 2026 MSG CTF platform. IDs are bigint unless an external instance ID requires UUID.'
}

Enum user_role {
  PARTICIPANT
  ADMIN
}

Enum challenge_type {
  STATIC
  DYNAMIC
  KOTH
}

Enum challenge_category {
  WEB
  PWN
  REV
  FORENSIC
  CRYPTO
  MISC
  AI
}

Enum board_tile_type {
  START
  CHALLENGE
  CHANCE
  AIRPORT
  QUARANTINE
  ROULETTE
}

Enum access_status {
  OFFERED
  OPEN
  EXPIRED
  SOLVED
  CLOSED
}

Enum instance_status {
  QUEUED
  PROVISIONING
  RUNNING
  FAILED
  TERMINATED
  EXPIRED
}

Enum mileage_source {
  CHALLENGE_SOLVE
  CHANCE_CARD
  ROULETTE
  PAYMENT
  REFUND
  ADMIN_ADJUSTMENT
  INSTANCE_EXTENSION
}

Enum payment_status {
  ISSUED
  APPROVED
  REFUNDED
  EXPIRED
  CANCELLED
}

Enum submission_result {
  CORRECT
  INCORRECT
  ALREADY_SOLVED
  RATE_LIMITED
}

Enum erd_source_type {
  DBML
  DDL
  JSON
}

Enum erd_check_category {
  INTEGRITY
  RELATIONSHIP
  NAMING
  CONSTRAINT
  PERFORMANCE
}

Enum erd_check_severity {
  ERROR
  WARNING
  INFO
}

Enum erd_check_run_status {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
}

Table contest_configs {
  id bigint [pk, increment]
  name varchar(100) [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  is_active boolean [not null, default: false]
  board_size int [not null, default: 36]
  challenge_time_limit_seconds int [not null, default: 900]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table teams {
  id bigint [pk, increment]
  name varchar(50) [not null, unique]
  total_score int [not null, default: 0]
  mileage_balance int [not null, default: 0]
  board_position int [not null, default: 0]
  is_banned boolean [not null, default: false]
  ban_reason varchar(255)
  banned_at timestamptz
  banned_by_user_id bigint
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table users {
  id bigint [pk, increment]
  login_id varchar(100) [not null, unique]
  password_hash varchar(255) [not null]
  email varchar(254) [unique]
  nickname varchar(50) [not null]
  university varchar(100)
  role user_role [not null, default: 'PARTICIPANT']
  team_id bigint
  is_team_leader boolean [not null, default: false]
  early_exit boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table refresh_tokens {
  id bigint [pk, increment]
  user_id bigint [not null]
  token_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null]
}

Table blacklisted_tokens {
  id bigint [pk, increment]
  jti varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  revoked_by_user_id bigint
  created_at timestamptz [not null]
}

Table api_idempotency_records {
  id bigint [pk, increment]
  scope varchar(100) [not null]
  idempotency_key varchar(255) [not null]
  team_id bigint
  user_id bigint
  request_hash varchar(128) [not null]
  response_status int
  response_body jsonb
  expires_at timestamptz [not null]
  created_at timestamptz [not null]

  Indexes {
    (scope, idempotency_key) [unique]
  }
}

Table ip_bans {
  id bigint [pk, increment]
  ip_address inet [not null]
  reason varchar(255) [not null]
  ban_type varchar(50) [not null]
  banned_at timestamptz [not null]
  expires_at timestamptz
  banned_by_user_id bigint
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table ip_activities {
  id bigint [pk, increment]
  user_id bigint
  login_id_snapshot varchar(100)
  ip_address inet [not null]
  activity_type varchar(50) [not null]
  request_uri varchar(500)
  details jsonb
  is_suspicious boolean [not null, default: false]
  occurred_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table admin_audit_logs {
  id bigint [pk, increment]
  actor_user_id bigint [not null]
  team_id bigint
  team_state_snapshot_id bigint
  action varchar(100) [not null]
  reason varchar(500)
  before_data jsonb
  after_data jsonb
  created_at timestamptz [not null]
}

Table team_state_snapshots {
  id bigint [pk, increment]
  team_id bigint [not null]
  captured_by_user_id bigint
  reason varchar(255) [not null]
  state_payload jsonb [not null]
  created_at timestamptz [not null]
}

Table files {
  id bigint [pk, increment]
  original_name varchar(255) [not null]
  content_type varchar(100) [not null]
  byte_size bigint [not null]
  storage_key varchar(500) [not null, unique]
  uploaded_by_user_id bigint
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table challenges {
  id bigint [pk, increment]
  title varchar(200) [not null]
  description text [not null]
  category challenge_category [not null]
  difficulty varchar(20)
  challenge_type challenge_type [not null, default: 'STATIC']
  flag_hash varchar(255) [not null]
  base_score int [not null]
  initial_score int
  minimum_score int
  mileage_reward int [not null, default: 0]
  starts_at timestamptz
  ends_at timestamptz
  is_visible boolean [not null, default: false]
  requires_instance boolean [not null, default: false]
  deployment_spec jsonb
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table challenge_files {
  challenge_id bigint [not null]
  file_id bigint [not null]
  display_order int [not null, default: 0]

  Indexes {
    (challenge_id, file_id) [pk]
  }
}

Table signatures {
  id bigint [pk, increment]
  code varchar(100) [not null, unique]
  name varchar(100) [not null]
  club_name varchar(100)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table challenge_signature_policies {
  id bigint [pk, increment]
  challenge_id bigint [not null]
  signature_id bigint [not null]
  policy_name varchar(100) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  Indexes {
    (challenge_id, signature_id) [unique]
  }
}

Table signature_codes {
  id bigint [pk, increment]
  challenge_id bigint [not null]
  code_hash varchar(255) [not null, unique]
  assigned_team_id bigint
  consumed_by_team_id bigint
  consumed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table team_signature_unlocks {
  id bigint [pk, increment]
  team_id bigint [not null]
  challenge_id bigint [not null]
  unlocked_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  Indexes {
    (team_id, challenge_id) [unique]
  }
}

Table board_tiles {
  id bigint [pk, increment]
  contest_config_id bigint [not null]
  tile_index int [not null]
  tile_type board_tile_type [not null]
  difficulty varchar(20)
  config jsonb
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (contest_config_id, tile_index) [unique]
  }
}

Table board_roll_policies {
  id bigint [pk, increment]
  contest_config_id bigint [not null, unique]
  rolls_per_reset int [not null, default: 1]
  reset_interval_seconds int [not null]
  next_reset_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table team_board_states {
  id bigint [pk, increment]
  team_id bigint [not null, unique]
  current_tile_id bigint
  dice_rolls_left int [not null, default: 1]
  last_dice_reset_at timestamptz
  next_dice_reset_at timestamptz
  timer_started_at timestamptz
  timer_ends_at timestamptz
  timer_end_reason varchar(30)
  quarantined_at timestamptz
  quarantine_escape_count int [not null, default: 0]
  active_challenge_access_id bigint
  updated_at timestamptz [not null]
}

Table dice_reset_logs {
  id bigint [pk, increment]
  team_id bigint [not null]
  board_roll_policy_id bigint [not null]
  rolls_before int [not null]
  rolls_after int [not null]
  reset_at timestamptz [not null]
}

Table team_tile_candidates {
  id bigint [pk, increment]
  team_id bigint [not null]
  tile_id bigint [not null]
  challenge_id bigint [not null]
  display_order int [not null]
  status varchar(20) [not null, default: 'OFFERED']
  offered_at timestamptz [not null]
  selected_at timestamptz
  expires_at timestamptz

  Indexes {
    (team_id, tile_id, challenge_id) [unique]
    (team_id, tile_id, display_order) [unique]
  }
}

Table team_challenge_accesses {
  id bigint [pk, increment]
  team_id bigint [not null]
  challenge_id bigint [not null]
  source_tile_id bigint
  source_candidate_id bigint [unique]
  access_source varchar(30) [not null]
  status access_status [not null, default: 'OPEN']
  opened_by_user_id bigint
  opened_at timestamptz [not null]
  expires_at timestamptz
  closed_at timestamptz

  Indexes {
    (team_id, challenge_id) [unique]
  }
}

Table team_challenge_overrides {
  id bigint [pk, increment]
  team_id bigint [not null]
  challenge_id bigint [not null]
  is_open boolean [not null]
  reason varchar(255) [not null]
  expires_at timestamptz
  granted_by_user_id bigint [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (team_id, challenge_id) [unique]
  }
}

Table dice_logs {
  id bigint [pk, increment]
  team_id bigint [not null]
  idempotency_record_id bigint [unique]
  dice_a int [not null]
  dice_b int [not null]
  rolled_number int [not null]
  from_tile_id bigint [not null]
  to_tile_id bigint [not null]
  created_at timestamptz [not null]
}

Table board_adjustment_logs {
  id bigint [pk, increment]
  team_id bigint [not null]
  actor_user_id bigint [not null]
  team_state_snapshot_id bigint
  action varchar(50) [not null]
  reason varchar(255) [not null]
  before_payload jsonb [not null]
  after_payload jsonb [not null]
  created_at timestamptz [not null]
}

Table chance_cards {
  id bigint [pk, increment]
  code varchar(100) [not null, unique]
  title varchar(100) [not null]
  description text [not null]
  effect_type varchar(50) [not null]
  effect_payload jsonb [not null]
  draw_weight int [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table team_chance_cards {
  id bigint [pk, increment]
  team_id bigint [not null]
  chance_card_id bigint [not null]
  source_tile_id bigint
  status varchar(20) [not null, default: 'AVAILABLE']
  granted_at timestamptz [not null]
  used_at timestamptz
  expires_at timestamptz
}

Table chance_draw_logs {
  id bigint [pk, increment]
  team_id bigint [not null]
  tile_id bigint [not null]
  team_chance_card_id bigint [not null, unique]
  idempotency_record_id bigint [unique]
  created_at timestamptz [not null]
}

Table airport_move_logs {
  id bigint [pk, increment]
  team_id bigint [not null]
  from_tile_id bigint [not null]
  to_tile_id bigint [not null]
  idempotency_record_id bigint [unique]
  created_at timestamptz [not null]
}

Table quarantine_attempts {
  id bigint [pk, increment]
  team_id bigint [not null]
  dice_a int
  dice_b int
  escaped boolean [not null]
  idempotency_record_id bigint [unique]
  created_at timestamptz [not null]
}

Table roulette_options {
  id bigint [pk, increment]
  code varchar(100) [not null, unique]
  description varchar(255) [not null]
  effect_type varchar(50) [not null]
  effect_payload jsonb [not null]
  draw_weight int [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table roulette_spins {
  id bigint [pk, increment]
  team_id bigint [not null]
  tile_id bigint [not null]
  roulette_option_id bigint [not null]
  idempotency_record_id bigint [unique]
  result_payload jsonb [not null]
  created_at timestamptz [not null]
}

Table challenge_solves {
  id bigint [pk, increment]
  team_id bigint [not null]
  challenge_id bigint [not null]
  challenge_access_id bigint
  solved_by_user_id bigint
  earned_score int [not null]
  mileage_reward int [not null, default: 0]
  solved_at timestamptz [not null]

  Indexes {
    (team_id, challenge_id) [unique]
  }
}

Table flag_submissions {
  id bigint [pk, increment]
  team_id bigint [not null]
  challenge_id bigint [not null]
  submitted_by_user_id bigint
  submitted_flag_hash varchar(255) [not null]
  result submission_result [not null]
  ip_address inet
  created_at timestamptz [not null]
}

Table challenge_instances {
  id uuid [pk]
  team_id bigint [not null]
  challenge_id bigint [not null]
  status instance_status [not null, default: 'QUEUED']
  host varchar(255)
  port int
  connection_uri varchar(500)
  infrastructure_node_id bigint
  requested_by_user_id bigint
  requested_at timestamptz [not null]
  started_at timestamptz
  expires_at timestamptz
  terminated_at timestamptz
  reset_count int [not null, default: 0]
  extension_count int [not null, default: 0]
  replaced_by_instance_id uuid
  last_error text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table instance_events {
  id bigint [pk, increment]
  instance_id uuid [not null]
  actor_user_id bigint
  event_type varchar(30) [not null]
  details jsonb
  created_at timestamptz [not null]
}

Table infrastructure_nodes {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]
  provider_account varchar(100)
  endpoint varchar(500)
  status varchar(30) [not null]
  cpu_capacity_millicores int
  memory_capacity_mib int
  instance_capacity int
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table node_resource_snapshots {
  id bigint [pk, increment]
  infrastructure_node_id bigint [not null]
  running_instance_count int [not null]
  cpu_used_millicores int
  memory_used_mib int
  details jsonb
  captured_at timestamptz [not null]
}

Table mileage_ledger {
  id bigint [pk, increment]
  team_id bigint [not null]
  source mileage_source [not null]
  amount int [not null]
  balance_after int
  reason varchar(255) [not null]
  related_challenge_solve_id bigint
  related_payment_transaction_id bigint
  actor_user_id bigint
  created_at timestamptz [not null]
}

Table qr_payment_tokens {
  id bigint [pk, increment]
  team_id bigint [not null]
  issued_by_user_id bigint [not null]
  token_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null]
}

Table payment_transactions {
  id bigint [pk, increment]
  team_id bigint [not null]
  qr_payment_token_id bigint
  requested_by_user_id bigint
  approved_by_user_id bigint
  refund_of_transaction_id bigint
  status payment_status [not null, default: 'ISSUED']
  mileage_amount int [not null]
  reason varchar(255) [not null]
  approved_at timestamptz
  refunded_at timestamptz
  created_at timestamptz [not null]
}

Table koth_clubs {
  id bigint [pk, increment]
  code varchar(100) [not null, unique]
  name varchar(100) [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table koth_challenges {
  id bigint [pk, increment]
  club_id bigint [not null]
  challenge_id bigint [not null, unique]
  current_holder_team_id bigint
  occupied_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (club_id, challenge_id) [unique]
  }
}

Table koth_rounds {
  id bigint [pk, increment]
  contest_config_id bigint [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  active_challenge_count int [not null, default: 2]
  status varchar(30) [not null]
  created_at timestamptz [not null]
}

Table koth_round_challenges {
  koth_round_id bigint [not null]
  koth_challenge_id bigint [not null]
  display_order int [not null]

  Indexes {
    (koth_round_id, koth_challenge_id) [pk]
    (koth_round_id, display_order) [unique]
  }
}

Table koth_team_scores {
  id bigint [pk, increment]
  team_id bigint [not null]
  club_id bigint [not null]
  score int [not null, default: 0]
  updated_at timestamptz [not null]

  Indexes {
    (team_id, club_id) [unique]
  }
}

Table koth_score_events {
  id bigint [pk, increment]
  team_id bigint [not null]
  club_id bigint [not null]
  score int [not null]
  request_id varchar(100) [not null, unique]
  signature_version varchar(30) [not null]
  scored_at timestamptz [not null]
  received_at timestamptz [not null]
}

Table koth_occupations {
  id bigint [pk, increment]
  koth_challenge_id bigint [not null]
  koth_round_id bigint
  team_id bigint [not null]
  occupied_at timestamptz [not null]
  released_at timestamptz
  release_reason varchar(100)
}

Table team_rank_snapshots {
  id bigint [pk, increment]
  contest_config_id bigint [not null]
  team_id bigint [not null]
  rank int [not null]
  total_score int [not null]
  last_solved_at timestamptz
  captured_at timestamptz [not null]

  Indexes {
    (contest_config_id, team_id, captured_at) [unique]
  }
}

Table user_rank_snapshots {
  id bigint [pk, increment]
  contest_config_id bigint [not null]
  user_id bigint [not null]
  rank int [not null]
  total_score int [not null]
  last_solved_at timestamptz
  university_snapshot varchar(100)
  captured_at timestamptz [not null]

  Indexes {
    (contest_config_id, user_id, captured_at) [unique]
  }
}

Table erd_schemas {
  id bigint [pk, increment]
  name varchar(100) [not null]
  source_type erd_source_type [not null]
  source_file_id bigint
  source_content text
  content_hash varchar(128) [not null]
  created_by_user_id bigint
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  Indexes {
    content_hash
  }
}

Table erd_check_rules {
  id bigint [pk, increment]
  rule_code varchar(100) [not null, unique]
  rule_name varchar(100) [not null]
  category erd_check_category [not null]
  severity erd_check_severity [not null, default: 'ERROR']
  description text [not null]
  config jsonb
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table erd_check_runs {
  id bigint [pk, increment]
  erd_schema_id bigint [not null]
  triggered_by_user_id bigint
  status erd_check_run_status [not null, default: 'QUEUED']
  total_issue_count int [not null, default: 0]
  error_count int [not null, default: 0]
  warning_count int [not null, default: 0]
  info_count int [not null, default: 0]
  checked_at timestamptz [not null]
  completed_at timestamptz
  summary jsonb
  created_at timestamptz [not null]

  Indexes {
    (erd_schema_id, checked_at)
    status
  }
}

Table erd_check_issues {
  id bigint [pk, increment]
  erd_check_run_id bigint [not null]
  erd_check_rule_id bigint [not null]
  severity erd_check_severity [not null]
  table_name varchar(100)
  column_name varchar(100)
  constraint_name varchar(100)
  index_name varchar(100)
  line_number int
  message text [not null]
  detail jsonb
  created_at timestamptz [not null]

  Indexes {
    (erd_check_run_id, erd_check_rule_id)
    (erd_check_run_id, table_name, column_name)
  }
}

Ref: users.team_id > teams.id
Ref: teams.banned_by_user_id > users.id
Ref: refresh_tokens.user_id > users.id
Ref: blacklisted_tokens.revoked_by_user_id > users.id
Ref: api_idempotency_records.team_id > teams.id
Ref: api_idempotency_records.user_id > users.id
Ref: ip_bans.banned_by_user_id > users.id
Ref: ip_activities.user_id > users.id
Ref: admin_audit_logs.actor_user_id > users.id
Ref: admin_audit_logs.team_id > teams.id
Ref: admin_audit_logs.team_state_snapshot_id > team_state_snapshots.id
Ref: team_state_snapshots.team_id > teams.id
Ref: team_state_snapshots.captured_by_user_id > users.id
Ref: files.uploaded_by_user_id > users.id

Ref: challenge_files.challenge_id > challenges.id
Ref: challenge_files.file_id > files.id
Ref: challenge_signature_policies.challenge_id > challenges.id
