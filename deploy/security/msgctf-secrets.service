[Unit]
Description=Load MSG service keys from encrypted credentials into tmpfs
After=local-fs.target
Before=docker.service

[Service]
Type=oneshot
LoadCredentialEncrypted=backend.env:/etc/credstore.encrypted/msgctf-backend-keys
ExecStart=/usr/bin/python3 /usr/local/lib/msgctf-security/sync_service_secrets.py
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=multi-user.target
